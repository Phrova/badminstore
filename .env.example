# ==============================================================================
# .env.example – mẫu biến môi trường. Sao chép thành `.env` (đã .gitignore) nếu dùng.
# Spring Boot không tự đọc .env: export biến hoặc dùng tool đọc file trước khi chạy.
# KHÔNG commit .env thật (chứa mật khẩu/token).
# ==============================================================================

# CSDL SQL Server
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=BadminStore;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=

# ADMIN + upload
ADMIN_EMAIL=admin@badstore.local
ADMIN_PASSWORD=
# UPLOAD_DIR=uploads

# Thông tin cửa hàng
# SHOP_NAME=BadStore
# SHOP_ADDRESS=Số 1 Đại Cồ Việt, Bách Khoa, Hà Nội
# SHOP_HOTLINE=1900 0000
# SHOP_EMAIL=cskh@badstore.local

# VietQR
# BANK_QR_ENABLED=true
# BANK_CODE=MB
# BANK_NAME=MB Bank (Ngân hàng Quân đội)
# BANK_ACCOUNT_NUMBER=0123456789
# BANK_ACCOUNT_NAME=CONG TY BADSTORE DEMO

# GHN: mặc định demo offline; muốn gọi thật đặt GHN_MOCK=false + GHN_TOKEN + GHN_SHOP_ID
# GHN_ENABLED=true
# GHN_MOCK=true
# GHN_MOCK_STATUS=delivering
# GHN_ENVIRONMENT=staging
# GHN_ALLOW_PRODUCTION=false
# GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
# GHN_PRINT_BASE_URL=https://dev-online-gateway.ghn.vn
# GHN_WEBHOOK_ENABLED=false
# GHN_WEBHOOK_SECRET=
# GHN_WEBHOOK_HEADER=X-GHN-Signature
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_ADDRESS_MODEL=auto
# GHN_FROM_DISTRICT_ID=
# GHN_FROM_WARD_CODE=
# GHN_FROM_PHONE=0900000000
# GHN_SYNC_ENABLED=false
